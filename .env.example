# Supabase — used only on the server in this phase (Home featured products).
# Project Settings → API in the Supabase dashboard.
# Never prefix the service role key with NEXT_PUBLIC_.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. Admin/seed scripts only. Never expose this to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Allow the local "mark as paid" button (decrements stock). Never enable in production.
# Customer payments are Yape / Plin / BCP until a real gateway is added.
PAYMENTS_TEST_MODE=false

# Auth magic links. In Supabase: Authentication → URL Configuration
# Site URL = your app origin. Redirect URLs must include:
# {SITE_URL}/auth/callback
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# After running supabase/migrations/20260820140000_admin_orders.sql,
# insert your /cuenta email into public.store_admins (see seed-store-admin.sql).
